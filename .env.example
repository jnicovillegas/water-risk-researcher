# Anthropic API key — required. This is an API key from https://console.anthropic.com
# (NOT your Claude.ai / Claude Code subscription). Cost per run is a few cents.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model. If the default below fails with a 404/not_found,
# set this to a model id your account has access to.
# WATERRISK_MODEL=claude-sonnet-5
