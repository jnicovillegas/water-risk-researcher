# Anthropic API key — REQUIRED. Get it at https://console.anthropic.com
# (a developer key, NOT your Claude.ai / Claude Code subscription). A run costs a few cents.
#
# The key MUST be Anthropic's: the tool relies on Anthropic's server-side web search,
# so a key from another provider (OpenAI, Google, etc.) will not work.
ANTHROPIC_API_KEY=sk-ant-...

# Model — any Anthropic (Claude) model. The default is claude-sonnet-5, which we
# recommend: it's economical and more than enough for this use case. Override only if
# needed (e.g. if that model id isn't available on your account).
# WATERRISK_MODEL=claude-sonnet-5
